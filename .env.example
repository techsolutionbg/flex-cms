# Application
APP_NAME="Flex CMS"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8090
APP_KEY=change-me-with-a-random-64-character-hex-string
APP_TIMEZONE=Europe/Sofia
# The platform always runs in UTC; APP_TIMEZONE is the default for the site time zone setting (emails, no-JavaScript text).
# FLEX_LEGACY_TIMEZONE= overrides the zone that pre-0.1.59 timestamps are converted from (defaults to php.ini date.timezone).
APP_LOCALE=bg
APP_FALLBACK_LOCALE=en
PUBLIC_HOME_SLUG=home
ACTIVE_THEME=flex-default
APP_MAINTENANCE=false
APP_CONFIG_CACHE=false
APP_CONTAINER_COMPILE=false

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_FORWARD_PORT=3306
DB_DATABASE=flex_cms
DB_USERNAME=flex_cms
DB_PASSWORD=flex_cms
DB_ROOT_PASSWORD=change-me
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=
DB_STRICT=true
DB_TIMEOUT=5
DB_PERSISTENT=false

# phpMyAdmin (development only)
PMA_HOST=mysql
PMA_PORT=3306
PMA_FORWARD_PORT=8081
PMA_ARBITRARY=0
PMA_UPLOAD_LIMIT=64M

# Sessions
SESSION_DRIVER=file
SESSION_NAME=flex_cms_session
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Cache
CACHE_DRIVER=array
CACHE_PREFIX=flex_cms
CACHE_TTL=0

# Logging
LOG_CHANNEL=single
LOG_LEVEL=debug
LOG_MAX_FILES=14

# Files and media
FILESYSTEM_DISK=local
MEDIA_DISK=public
MEDIA_PATH=public/media
MEDIA_MAX_UPLOAD_MB=64
IMAGE_DRIVER=gd

# Mail
# Local Docker delivery stays in Mailpit. For production, replace MAILER_DSN
# with your provider's SMTP DSN and configure the authorized sender below.
MAILER_DSN=smtp://mailpit:1025
MAIL_FROM_ADDRESS=noreply@localhost
MAIL_FROM_NAME="Flex CMS"
MAILPIT_SMTP_FORWARD_PORT=1025
MAILPIT_FORWARD_PORT=8025

# Extensions and updates
PLUGINS_PATH=plugins
THEMES_PATH=themes
UPDATE_CHANNEL=stable
UPDATE_CHECK_ENABLED=true
UPDATE_SERVER_URL=https://updates-flex-cms.kriskata.com
UPDATE_REQUIRE_CHECKSUM=true
UPDATE_REQUIRE_SIGNATURE=true
# Base64-encoded Ed25519 public key used to verify platform package manifests.
UPDATE_SIGNING_PUBLIC_KEY="f8jqe8uwSmPX8JKDKAxlTzAMYSnVcAuUHHRsUMd+5dQ="
UPDATE_HEALTHCHECK_URL=http://127.0.0.1/health
UPDATE_MAX_UNCOMPRESSED_MB=256
UPDATE_MAX_DOWNLOAD_MB=256

# Security and HTTP
TRUSTED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXIES=
FORCE_HTTPS=false
CSRF_TOKEN_LIFETIME=7200
