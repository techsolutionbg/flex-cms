# Application
APP_NAME="Flex CMS"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
APP_KEY=change-me-with-a-random-64-character-hex-string
APP_VERSION=0.1.0-dev
APP_TIMEZONE=Europe/Sofia
APP_LOCALE=bg
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE=false

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_FORWARD_PORT=33060
DB_DATABASE=flex_cms
DB_USERNAME=flex_cms
DB_PASSWORD=flex_cms
DB_ROOT_PASSWORD=change-me
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=
DB_STRICT=true

# phpMyAdmin (development only)
PMA_HOST=mysql
PMA_PORT=3306
PMA_FORWARD_PORT=8081
PMA_ARBITRARY=0
PMA_UPLOAD_LIMIT=64M

# Sessions
SESSION_DRIVER=file
SESSION_NAME=flex_cms_session
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Cache
CACHE_DRIVER=file
CACHE_PREFIX=flex_cms
CACHE_TTL=3600

# Logging
LOG_CHANNEL=single
LOG_LEVEL=debug
LOG_MAX_FILES=14

# Files and media
FILESYSTEM_DISK=local
MEDIA_DISK=public
MEDIA_PATH=public/media
MEDIA_MAX_UPLOAD_MB=64
IMAGE_DRIVER=gd

# Mail
MAILER_DSN=null://null
MAIL_FROM_ADDRESS=noreply@localhost
MAIL_FROM_NAME="Flex CMS"

# Extensions and updates
PLUGINS_PATH=plugins
THEMES_PATH=themes
UPDATE_CHANNEL=stable
UPDATE_CHECK_ENABLED=true
UPDATE_SERVER_URL=

# Security and HTTP
TRUSTED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXIES=
FORCE_HTTPS=false
CSRF_TOKEN_LIFETIME=7200
