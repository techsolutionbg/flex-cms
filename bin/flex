#!/usr/bin/env php
<?php

declare(strict_types=1);

use Flex\Bootstrap;
use Flex\Console\FlexConsoleApplication;

$basePath = dirname(__DIR__);
require $basePath . '/vendor/autoload.php';

$application = Bootstrap::boot($basePath)->container()->get(FlexConsoleApplication::class);
if (!$application instanceof FlexConsoleApplication) {
    throw new RuntimeException('The console application service is invalid.');
}

exit($application->run());
