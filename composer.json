{
    "name": "flex-cms/flex-cms",
    "description": "A modular CMS for PHP and MySQL hosting.",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pcre": "*",
        "ext-pdo": "*",
        "ext-session": "*",
        "ext-tokenizer": "*",
        "ext-xml": "*",
        "ext-zip": "*",
        "composer/semver": "^3.4",
        "ezyang/htmlpurifier": "^4.19",
        "guzzlehttp/guzzle": "^7.10",
        "illuminate/database": "^13.0",
        "league/flysystem": "^3.0",
        "league/route": "^7.0",
        "monolog/monolog": "^3.0",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "php-di/php-di": "^7.1",
        "psr/event-dispatcher": "^1.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "robmorgan/phinx": "^0.16",
        "symfony/console": "^7.4",
        "symfony/mailer": "^7.4",
        "symfony/translation": "^7.4",
        "twig/twig": "^3.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Flex\\": "src/",
            "Flex\\Contracts\\": "contracts/",
            "Flex\\Extension\\V1\\": "contracts/Extension/V1/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flex\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/flex"
    ],
    "config": {
        "allow-plugins": {},
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "style": "php-cs-fixer fix --allow-risky=yes",
        "style:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "security:audit": "composer audit --locked",
        "check": [
            "composer validate --strict",
            "@test",
            "@analyse",
            "@style:check",
            "@security:audit"
        ],
        "check:all": [
            "@check",
            "npm --prefix resources/admin run check"
        ],
        "test": "phpunit"
    }
}
