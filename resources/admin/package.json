{
  "name": "flex-admin",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "tsc -b && vite build --mode development",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run check:css && npm run check:dead-code && npm run build",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "check:css": "stylelint \"src/**/*.css\"",
    "check:dead-code": "knip",
    "check:dependencies": "npm audit --audit-level=high",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "alpinejs": "^3.17.4",
    "jquery": "^4.0.0",
    "quill": "^2.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@fontsource-variable/geist": "^5.3.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4",
    "@types/jquery": "^4.0.1",
    "@types/node": "^24.13.6",
    "eslint": "^10",
    "globals": "^17",
    "jsdom": "^26.1.0",
    "knip": "^5.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^39.0.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5.0.1"
  }
}
