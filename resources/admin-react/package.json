{
  "name": "flex-admin-react",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.cjs",
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build",
    "build:admin": "tsc -b && vite build --config vite.admin.config.ts",
    "build:installer": "tsc -b && vite build --config vite.installer.config.ts",
    "build:time": "vite build --config vite.time.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "1.11.13",
    "lucide-react": "^0.468.0",
    "quill": "2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.0"
  },
  "overrides": {
    "dompurify": "3.4.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.13.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "3.6.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~6.0.0",
    "vite": "^8.3.0"
  }
}
