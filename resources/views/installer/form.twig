<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><link rel="icon" href="/assets/brand/favicon.png"><title>Install Flex CMS</title>{{ vite_tags|raw }}</head><body class="installer-page">{% import 'components/form-fields.twig' as fields %}<header><p class="eyebrow">Flex CMS</p><h1>Let’s build your site.</h1><p class="lead">Check the server, connect MySQL and create the first administrator.</p></header>{% if error %}<div class="notice error" role="alert">{{ error }}</div>{% endif %}<form method="post" action="/install" autocomplete="off"><input type="hidden" name="csrf_token" value="{{ csrf_token }}">{% for section in sections %}<section class="installer-section"><div class="section-heading"><span>0{{ loop.index }}</span><div><h2>{{ section.title }}</h2><p>{{ section.description }}</p></div></div><div class="installer-grid">{% for field in section.fields %}{{ fields.input(field.label, field.name, field.type, field.value, field.placeholder) }}{% endfor %}</div></section>{% endfor %}{% if generated_password %}<p class="field-note">Generated password: <code>{{ generated_password }}</code>. Change it before production use.</p>{% endif %}<button type="submit">Install Flex CMS →</button></form></body></html>
