<!doctype html>
<html lang="bg">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <link rel="icon" type="image/png" href="/assets/brand/favicon.png">
    <title>Вход · Flex CMS</title>
    {{ vite_tags|raw }}
</head>
<body class="auth-page" x-data="loginForm">
    <main class="auth-card">
        <a class="auth-brand" href="/" aria-label="Flex CMS">
            <img src="/assets/brand/logo.png" alt="Flex CMS">
        </a>
        <p>Влезте, за да управлявате сайта.</p>
        {% if error %}
            <div class="auth-alert" role="alert">
                <span class="auth-alert-icon" aria-hidden="true">!</span>
                <span>{{ error }}</span>
            </div>
        {% endif %}
        {% import 'components/form-fields.twig' as fields %}
        <form method="post" action="/login" @submit="submitting = true">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            {{ fields.input('Имейл', 'email', 'email', '', '', 'username', true) }}
            {{ fields.input('Парола', 'password', 'password', '', '', 'current-password') }}
            <button type="submit" :disabled="submitting" x-text="submitting ? 'Проверка…' : 'Вход →'">Вход →</button>
        </form>
    </main>
</body>
</html>
