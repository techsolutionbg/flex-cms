# Copy this file to .publish.env and fill in local release settings.
# Never commit the private signing key or SSH private key.
UPDATE_SERVER_BASE_URL=https://updates-flex-cms.kriskata.com
UPDATE_SSH_TARGET=kriskata-hosting
UPDATE_REMOTE_ROOT=updates-flex-cms.kriskata.com
UPDATE_SIGNING_PRIVATE_KEY_FILE=C:/Users/your-name/.ssh/flex-update-private.key
UPDATE_SIGNING_KEY_ID=release-2026-v3
UPDATE_COMPATIBLE_FROM=>=0.1.0 <1.0.0
