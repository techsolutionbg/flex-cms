Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    # Pages are never cached. Theme and plugin files set their own Cache-Control: versioned URLs (?v=) are kept
    # for good, others are checked with the server; static files under /assets/ use the server defaults.
    Header setifempty X-Content-Type-Options "nosniff"
    Header setifempty Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" "expr=%{REQUEST_URI} !~ m#^/build/.*/assets/# && %{THE_REQUEST} !~ m#\s/+(\S*/)?(extensions/\S+/assets/|themes/[^/\s]+/(assets/|style\.css[\s?]))# && %{REQUEST_URI} !~ m#^/assets/# && %{THE_REQUEST} !~ m#\s/+media-files/#"
    Header always set Pragma "no-cache" "expr=%{REQUEST_URI} !~ m#^/build/.*/assets/# && %{THE_REQUEST} !~ m#\s/+(\S*/)?(extensions/\S+/assets/|themes/[^/\s]+/(assets/|style\.css[\s?]))# && %{REQUEST_URI} !~ m#^/assets/# && %{THE_REQUEST} !~ m#\s/+media-files/#"
    Header always set Expires "0" "expr=%{REQUEST_URI} !~ m#^/build/.*/assets/# && %{THE_REQUEST} !~ m#\s/+(\S*/)?(extensions/\S+/assets/|themes/[^/\s]+/(assets/|style\.css[\s?]))# && %{REQUEST_URI} !~ m#^/assets/# && %{THE_REQUEST} !~ m#\s/+media-files/#"
    Header always set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#^/build/.*/assets/#"
</IfModule>
